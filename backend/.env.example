# Google Gemini API key for query routing, text-to-SQL, and synthesis
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Cricket Live Data API (Optional: CricAPI key or RapidAPI key; mock simulation runs automatically if unset)
CRICKET_API_KEY=
CRICKET_API_BASE_URL=https://api.cricapi.com/v1

# Storage Paths
ENABLE_LIVE_MOCK_FALLBACK=True

